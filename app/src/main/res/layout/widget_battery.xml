<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget: name, battery, EQ preset or connection state. RemoteViews-safe views only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/widget_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="OpenDrop"
        android:textColor="@color/widget_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_battery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:text="–"
        android:textColor="@color/widget_primary"
        android:textSize="26sp" />

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Not connected"
        android:textColor="@color/widget_secondary"
        android:textSize="13sp" />
</LinearLayout>
