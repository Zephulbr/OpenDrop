<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 8–11: classic Bluetooth access. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <!-- Android 12+: talk to already-paired devices. No scanning, no location. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Keep the connection alive in the background while the earbuds are connected. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Android 13+: show the connection notification (and its Disconnect button) in the shade. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Phone EQ: an audio effect on the output mix, kept alive by a foreground service. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:name=".OpenDropApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="OpenDrop"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenDrop">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".device.AclReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
            </intent-filter>
        </receiver>
        <!-- Commands from Tasker and similar apps; ignored unless allowed in Settings. -->
        <receiver
            android:name=".automation.AutomationReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="org.opendrop.app.action.SET_EQ" />
                <action android:name="org.opendrop.app.action.NEXT_EQ" />
                <action android:name="org.opendrop.app.action.CONNECT" />
                <action android:name="org.opendrop.app.action.DISCONNECT" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".widget.BatteryWidget"
            android:exported="false"
            android:label="OpenDrop">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_battery_info" />
        </receiver>
        <service
            android:name=".tile.EqTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_opendrop"
            android:label="@string/tile_eq"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>
        <service
            android:name=".phoneeq.PhoneEqService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a user-enabled system-wide audio equalizer effect running" />
        </service>
        <service
            android:name=".device.ConnectionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>

</manifest>
